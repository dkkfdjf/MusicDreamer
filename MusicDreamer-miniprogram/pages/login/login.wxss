/* pages/login/login.wxss */
.lg { padding: 90rpx 50rpx; }
.lg-logo { text-align: center; margin-bottom: 60rpx; }
.lg-badge {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 24rpx;
  font-size: 64rpx; color: #fff;
  background: linear-gradient(135deg, #ff6b1a, #e11d92);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 26, 0.35);
}
.lg-title { font-size: 52rpx; font-weight: 800; letter-spacing: 4rpx; }
.lg-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 10rpx; }
.lg-tabs { display: flex; margin-bottom: 30rpx; }
.lg-tab { flex: 1; text-align: center; padding: 20rpx 0; color: var(--text-sub); border-bottom: 4rpx solid transparent; }
.lg-tab.on { color: var(--brand); border-bottom-color: var(--brand); font-weight: 700; }
.lg-form { padding: 40rpx 30rpx; }
.lg-input { border-bottom: 1rpx solid var(--line); padding: 24rpx 8rpx; font-size: 30rpx; }
.lg-ph { color: #c5bfb4; }
.lg-btn { margin-top: 50rpx; height: 88rpx; line-height: 88rpx; font-size: 32rpx; }
.lg-note { text-align: center; font-size: 22rpx; color: var(--text-sub); margin-top: 24rpx; }
