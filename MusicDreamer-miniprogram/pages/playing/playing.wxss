/* pages/playing/playing.wxss */
.py {
  display: flex; flex-direction: column;
  height: 100vh;
  padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}
.py-tabs { display: flex; justify-content: center; gap: 40rpx; margin-bottom: 20rpx; }
.py-tab { color: var(--text-sub); padding: 8rpx 20rpx; border-bottom: 4rpx solid transparent; }
.py-tab.on { color: var(--brand); border-color: var(--brand); font-weight: 700; }

.py-cover-wrap { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; }
.py-disc {
  width: 66vw; height: 66vw; max-width: 560rpx; max-height: 560rpx;
  padding: 20rpx;
  background: var(--card);
  border-radius: 50%;
  box-shadow: 0 20rpx 60rpx rgba(93, 76, 60, 0.25);
}
.py-cover { width: 100%; height: 100%; border-radius: 50%; background: var(--line); }
.py-cover.spin { animation: py-rotate 20s linear infinite; }
@keyframes py-rotate { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.py-lyrics { flex: 1; min-height: 0; }
.py-line { text-align: center; padding: 16rpx 0; color: var(--text-sub); font-size: 28rpx; transition: all 0.3s; }
.py-line.on { color: var(--brand); font-size: 34rpx; font-weight: 700; }
.py-pad { height: 40vh; }
.py-empty { text-align: center; color: var(--text-sub); padding-top: 30vh; }

.py-name { font-size: 40rpx; font-weight: 800; text-align: center; margin-top: 24rpx; }
.py-singer { font-size: 26rpx; color: var(--text-sub); text-align: center; margin: 10rpx 0 30rpx; }

.py-progress { display: flex; align-items: center; margin-bottom: 20rpx; }
.py-time { font-size: 22rpx; color: var(--text-sub); width: 80rpx; text-align: center; flex-shrink: 0; }
.py-slider { flex: 1; margin: 0 8rpx; }

.py-controls { display: flex; align-items: center; justify-content: space-between; }
.py-ctl { font-size: 48rpx; color: var(--text); }
.py-side { font-size: 40rpx; width: 90rpx; text-align: center; }
.py-side.fav-on { color: var(--brand); }
.py-main { font-size: 60rpx; }
.py-play {
  width: 130rpx; height: 130rpx; line-height: 130rpx; text-align: center;
  font-size: 64rpx; color: #fff;
  background: linear-gradient(135deg, #ff6b1a, #e11d92);
  border-radius: 50%;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 26, 0.35);
}
.py-mode-text { font-size: 20rpx; color: var(--text-sub); }

.py-none { text-align: center; padding-top: 35vh; color: var(--text-sub); }
.py-none-icon { font-size: 100rpx; color: var(--line); margin-bottom: 20rpx; }
.py-none-btn { margin: 40rpx auto 0; width: 240rpx; }
